# React Native CLI
# Development on the same machine / Android emulator:
API_URL=http://localhost:4000

# Physical Android/iOS device on the same Wi-Fi (do not commit a developer IP):
# API_URL=http://192.168.x.x:4000

# Staging API:
# API_URL=https://api-staging.example.com

# Legacy alias still accepted:
# EXPO_PUBLIC_API_URL=http://localhost:4000

# Backend variables live in backend/.env.example — never put API secrets in the app env.
