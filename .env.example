# Expo / React Native
# Development on the same machine:
EXPO_PUBLIC_API_URL=http://localhost:4000

# Physical Android/iOS device on the same Wi-Fi (do not commit a developer IP):
# EXPO_PUBLIC_API_URL=http://192.168.x.x:4000

# Staging API:
# EXPO_PUBLIC_API_URL=https://api-staging.example.com

# Backend variables live in backend/.env.example — never put API secrets in Expo env.
