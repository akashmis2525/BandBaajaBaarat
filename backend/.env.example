PORT=4000
NODE_ENV=development
BIND_HOST=0.0.0.0
MONGODB_URI=mongodb://127.0.0.1:27017/bandbaajabaarat
JWT_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=BANDBAJA
SMS_TEMPLATE_ID=
SMS_API_URL=
TWILIO_ACCOUNT_SID=
PAYMENT_GATEWAY=

# Staging example (copy to backend/.env, never commit the real file):
# NODE_ENV=staging
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bandbaajabaarat_staging
# JWT_SECRET=long-random-staging-secret
# JWT_REFRESH_SECRET=long-random-staging-refresh-secret
# CORS_ORIGIN=https://staging.example.com
# PUBLIC_BASE_URL=https://api-staging.example.com
# SMS_PROVIDER=msg91
# SMS_API_KEY=
# SMS_TEMPLATE_ID=
# PAYMENT_GATEWAY=

# Rules:
# NODE_ENV=staging|production requires JWT_SECRET, JWT_REFRESH_SECRET, MONGODB_URI, and explicit CORS_ORIGIN (never *).
# Staging/production never return OTP in API responses. SMS_PROVIDER + SMS_API_KEY are required to deliver OTP.
# PAYMENT_GATEWAY must be set before live checkout. Staging may record ledger payments without a processor.
# Bind address is 0.0.0.0. Physical devices: EXPO_PUBLIC_API_URL=http://<LAN-IP>:4000
# npm run seed is STAGING/DEVELOPMENT only. It is blocked when NODE_ENV=production.
